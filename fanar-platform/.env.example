# Fanar Phase 0 — example environment. Copy to .env (git-ignored). NEVER put real secrets here;
# in production these come from Vault (see src/fanar/security/secrets.py).

FANAR_ENV=dev
FANAR_TENANT=entity1

# --- Database (Postgres: event store + projections) ---
FANAR_DB_DSN=postgresql+psycopg://fanar:fanar@localhost:5432/fanar

# --- Identity (Keycloak) — backend validates bearer JWT; SPA/BFF does auth-code+PKCE ---
FANAR_OIDC_ISSUER=https://localhost:8443/realms/fanar
FANAR_OIDC_AUDIENCE=fanar-api
FANAR_OIDC_JWKS_URL=https://localhost:8443/realms/fanar/protocol/openid-connect/certs
FANAR_OIDC_CLIENT_ID=fanar-frontend
FANAR_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# BFF session cookie (tokens stay server-side; browser only holds this opaque id)
FANAR_SESSION_COOKIE=fanar_session
FANAR_COOKIE_SECURE=true

# --- Secrets backend: "env" (dev) or "vault" (prod) ---
FANAR_SECRETS_BACKEND=env
FANAR_VAULT_ADDR=https://localhost:8200

# --- Anti-corruption layer → Manar (strangler phase). Service account via Vault in prod. ---
FANAR_MANAR_BASE_URL=http://192.168.1.104
FANAR_MANAR_READ_ONLY=true
# FANAR_MANAR_USERNAME / FANAR_MANAR_PASSWORD come from the secrets backend, never from source.
